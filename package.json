{
  "name": "dsh-terminal-theme",
  "version": "1.0.0",
  "description": "Per-panel color themes for the DeepSeek Harness terminal: pick, import and switch palettes that touch only the terminal, never the rest of DSH.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "terminal",
    "theme",
    "color-scheme",
    "ansi"
  ],
  "type": "module",
  "license": "MIT",
  "author": "NanBei.W",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wnanbei/dsh-terminal-theme.git"
  },
  "homepage": "https://github.com/wnanbei/dsh-terminal-theme#readme",
  "bugs": {
    "url": "https://github.com/wnanbei/dsh-terminal-theme/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs"
  }
}
